# Set a unique random value before production use. Example: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Required once to create/reset the legacy bootstrap admin; use 12+ unique characters.
TAVIDM_BOOTSTRAP_ADMIN_PASSWORD=
DB_BACKEND=sqlite
DATABASE_URL=database/tavidm.db
# SQLITE_PATH kept for backward compatibility; optional.
# SQLITE_PATH=database/tavidm.db
UPLOAD_FOLDER=dataset/raw

# Max single upload size in MB. Default 3072 MB (3 GiB) — recorded footage can
# be large, but uploads are saved in full to dataset/raw, so only use this after
# confirming there is enough free disk (see UPLOAD_DISK_HEADROOM_MB below).
# Env-driven; the UI reads MAX_UPLOAD_MB and shows it on the upload panel.
MAX_UPLOAD_MB=3072

# Free-disk headroom (MB) required in addition to the file size before an upload
# is accepted. Guards against filling the volume during save + frame extraction.
UPLOAD_DISK_HEADROOM_MB=500

# Motorcycle detail review (uploaded videos only).
# Designate the detail checkpoint EXPLICITLY. Nothing defaults to a training
# candidate. This is a SEPARATE three-class crop detector; the main 15-class
# object checkpoint is not a valid detail checkpoint. The crop pass fails closed
# unless the checkpoint is a detect model whose class map is exactly
# 0=helmet_nut_shell, 1=helmet_acceptable, 2=side_mirror. Any other order
# (including the exploratory pilot order side_mirror, helmet_nut_shell,
# helmet_acceptable) is rejected; IDs are never relabeled. Rider and motorcycle
# attribution always come from the main detector's saved context.
# TAVIDM_MOTORCYCLE_DETAIL_WEIGHTS=
# Set to 0 to stop collecting motorcycle detail candidates during processing.
# Candidates still work when only the older 7/10-class runtime checkpoint is
# selected; without a designated detail checkpoint the crops stay queued.
TAVIDM_MOTORCYCLE_DETAIL_ENABLED=1

# Future migration target example:
# DATABASE_URL=postgresql://user:***@host:5432/dbname
# CONF_THRESHOLD=0.60
# REVIEW_THRESHOLD=0.75
